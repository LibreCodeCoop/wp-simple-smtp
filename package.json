{
	"name": "wp-simple-smtp",
	"private": true,
	"license": "GPL-2.0-or-later",
	"description": "Browser tests for Simple SMTP",
	"scripts": {
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"env:start": "docker compose -f tests/E2E/docker-compose.yml up -d --wait && docker compose -f tests/E2E/docker-compose.yml run --rm cli",
